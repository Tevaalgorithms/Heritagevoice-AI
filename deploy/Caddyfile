# HTTPS is automatic for a real domain (Let's Encrypt). The API is reachable only on these
# paths; everything else goes to the UI. /docs and /openapi.json are not exposed.
# `www.` goes to the main address, so there is one official address. Caddy gets a certificate for
# it too, once its DNS record exists (Terraform adds it when the site is at the top of a domain).
www.{$HV_DOMAIN} {
	redir https://{$HV_DOMAIN}{uri} permanent
}

{$HV_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /v1/* /admin/* /health /ready
	handle @api {
		request_body {
			max_size 210MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy ui:8501 {
			# Sign-out: Streamlit sends the browser to Cognito's /logout with the standard OIDC
			# parameters, but Cognito insists on `logout_uri` and answers "Required parameters
			# missing". Add it, pointing back at this site, so signing out ends the Cognito session
			# and lands on the home page. Only redirects to Cognito's logout address are touched:
			# Amazon's own domain, or login.<this domain> when a custom sign-in domain is used.
			header_down Location "^(https://(?:[^/]+\.amazoncognito\.com|login\.{$HV_DOMAIN})/logout\?.*)$" "$1&logout_uri=https%3A%2F%2F{http.request.host}%2F"
		}
	}
}
