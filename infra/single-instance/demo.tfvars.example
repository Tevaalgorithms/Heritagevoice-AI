# Copy to demo.tfvars (git-ignored) and fill in. Values here are placeholders.
region                = "us-west-2"
environment           = "demo"
domain                = "heritagevoice.tevaalgorithms.com"
route53_zone_name     = "tevaalgorithms.com"
repo_url              = "https://github.com/Tevaalgorithms/Heritagevoice-AI.git"
repo_ref              = "main" # use a release tag when sharing
cognito_user_pool_id  = "<from infra/cognito output>"
cognito_app_client_id = "<from infra/cognito output>"
budget_email          = "<your email>"
