{
  "components": {
    "schemas": {
      "CommunitiesRequest": {
        "additionalProperties": false,
        "properties": {
          "communities": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "title": "Communities",
            "type": "array"
          }
        },
        "required": [
          "communities"
        ],
        "title": "CommunitiesRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InviteRequest": {
        "additionalProperties": false,
        "properties": {
          "communities": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "title": "Communities",
            "type": "array"
          },
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "member"
          }
        },
        "required": [
          "email"
        ],
        "title": "InviteRequest",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "question": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "Role": {
        "enum": [
          "member",
          "reviewer",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "HeritageVoice AI",
    "version": "0.1.0"
  },
