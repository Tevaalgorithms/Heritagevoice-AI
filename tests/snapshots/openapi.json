{
  "components": {
    "schemas": {
      "CommunitiesRequest": {
        "additionalProperties": false,
        "properties": {
          "communities": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "title": "Communities",
            "type": "array"
          }
        },
        "required": [
          "communities"
        ],
        "title": "CommunitiesRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InviteRequest": {
        "additionalProperties": false,
        "properties": {
          "communities": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "title": "Communities",
            "type": "array"
          },
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "member"
          }
        },
        "required": [
          "email"
        ],
        "title": "InviteRequest",
        "type": "object"
      },
      "JobResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "recording_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recording Id"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "stage",
          "error",
          "recording_id"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "question": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "RecordingResponse": {
        "properties": {
          "community_id": {
            "title": "Community Id",
            "type": "string"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transcript": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "translation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "community_id",
          "language",
          "status",
          "duration_s",
          "transcript",
          "translation"
        ],
        "title": "RecordingResponse",
        "type": "object"
      },
      "Role": {
        "enum": [
          "member",
          "reviewer",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleRequest",
        "type": "object"
      },
      "Segment": {
        "additionalProperties": false,
        "properties": {
          "end_s": {
            "minimum": 0.0,
            "title": "End S",
            "type": "number"
          },
          "segment_id": {
            "minLength": 1,
            "title": "Segment Id",
            "type": "string"
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker"
          },
          "start_s": {
            "minimum": 0.0,
            "title": "Start S",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "start_s",
          "end_s",
          "text"
        ],
        "title": "Segment",
        "type": "object"
      },
      "UploadForm": {
        "additionalProperties": false,
        "properties": {
          "community_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Community Id",
            "type": "string"
          },
          "consent_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Consent Id",
            "type": "string"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "language": {
            "pattern": "^[a-z]{2,8}$",
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "file",
          "language",
          "community_id",
          "consent_id"
        ],
        "title": "UploadForm",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "recording_id": {
            "title": "Recording Id",
            "type": "string"
          }
        },
        "required": [
          "recording_id",
          "job_id"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionView": {
        "properties": {
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "title": "Segments",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "status",
          "segments"
        ],
        "title": "VersionView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
