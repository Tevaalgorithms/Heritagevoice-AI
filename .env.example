# No credentials are required for health checks or unit tests.
# Generate a long random token for local development only. Never commit it.
HERITAGEVOICE_DEV_API_TOKEN=
# local = the dev token is accepted; anything else = Cognito only. Dev role: member|reviewer|admin.
HERITAGEVOICE_ENVIRONMENT=local
HERITAGEVOICE_DEV_ROLE=member
HERITAGEVOICE_API_URL=http://127.0.0.1:8000
# All integration adapters remain unimplemented in this scaffold.
LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=heritagevoice-ai-dev

# Local infrastructure (docker compose); values are never committed.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Database, storage and model provider.
HERITAGEVOICE_DATABASE_URL=
HERITAGEVOICE_AWS_REGION=
HERITAGEVOICE_AUDIO_BUCKET=
# Optional: KMS key for encrypting stored audio and transcripts, and a local folder for development
# (use a path inside the git-ignored data/ directory; used only when no bucket is set).
HERITAGEVOICE_AUDIO_KMS_KEY_ID=
HERITAGEVOICE_AUDIO_LOCAL_DIR=
# Upload limits and languages (comma separated), and the speech service: transcribe | fake
# (fake is accepted only when HERITAGEVOICE_ENVIRONMENT=local).
HERITAGEVOICE_MAX_AUDIO_MB=200
HERITAGEVOICE_MAX_AUDIO_MINUTES=120
HERITAGEVOICE_ALLOWED_LANGUAGES=ta,en
HERITAGEVOICE_ASR_PROVIDER=transcribe
HERITAGEVOICE_LLM_API_KEY=

# Pinecone (vectors). Create a serverless index whose dimension matches the embedding model.
HERITAGEVOICE_EMBEDDING_MODEL=multilingual-e5-large
HERITAGEVOICE_EMBEDDING_DIMENSION=1024
PINECONE_API_KEY=
PINECONE_INDEX=

# Neo4j (reviewed graph): separate read-only and write users.
NEO4J_URI=
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
NEO4J_WRITE_USER=
NEO4J_WRITE_PASSWORD=

# Amazon Cognito (identity). IDs are configuration, not secrets. Leave empty for local runs.
HERITAGEVOICE_COGNITO_REGION=
HERITAGEVOICE_COGNITO_USER_POOL_ID=
HERITAGEVOICE_COGNITO_APP_CLIENT_ID=

# Lets an admin approve their own upload. Leave unset (false) unless a deployment has a single admin.
HERITAGEVOICE_ALLOW_SELF_REVIEW=
