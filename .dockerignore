# Keep secrets, state, local data and heavy or irrelevant files out of the image.
.git
.github
.venv
.env
.env.*
!.env.example
.streamlit/secrets.toml
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
data
docs
assets
evals
tests
infra
deploy
**/.terraform
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan

# macOS metadata files (AppleDouble); alembic would try to load them as migrations
**/._*
**/.DS_Store
